# Free tiers, no credit card. Set at least one, or run Ollama locally.
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys

# Optional models (defaults shown)
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Optional, paid, off by default: only for quality comparisons
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Provider order and cassette mode
# LLM_PROVIDERS=gemini,groq,ollama
# LLM_PROVIDER=ollama           # force a single provider
# LLM_MODE=auto                 # auto | replay | record | live
